# Recovered from the archived K=15 scripts.
# Verify every value against the exact submitted image.

MODEL_ID=/opt/ml/model
TOKENIZER_ID=/opt/ml/model
SERVED_MODEL_NAME=Qwen/Qwen3.5-4B

QUANTIZATION=awq_marlin
SPECULATIVE_CONFIG={"method":"dflash","model":"/opt/ml/dflash-draft","num_speculative_tokens":15}

ENABLE_PREFIX_CACHING=1
LANGUAGE_MODEL_ONLY=1
VLLM_EXTRA_ARGS=--skip-mm-profiling

MAX_MODEL_LEN=8448
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.90
DTYPE=half

TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_OFFLINE=1

