FROM docker.io/adaptfm/adaptfm-base:latest

ARG VLLM_GIT_REF=v0.20.1
ARG TORCH_CUDA_ARCH_LIST=8.6
ARG MAX_JOBS=2

ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ENV MAX_JOBS=${MAX_JOBS}

COPY patches/patch_qwen3_dflash_dtype.py /tmp/patch_qwen3_dflash_dtype.py

RUN python3 -c "import glob, os, shutil; patterns=['/usr/local/lib/python3.10/dist-packages/vllm','/usr/local/lib/python3.10/dist-packages/vllm-*']; [shutil.rmtree(path) if os.path.isdir(path) else os.remove(path) for pattern in patterns for path in glob.glob(pattern) if os.path.exists(path)]" && \
    python3 -m pip install --no-cache-dir \
      'setuptools>=80' 'setuptools_scm>=8' 'cmake<4' ninja numpy && \
    git clone --depth 1 --branch "$VLLM_GIT_REF" \
      https://github.com/vllm-project/vllm.git /tmp/vllm && \
    python3 -m pip install --no-cache-dir --no-deps \
      --no-build-isolation /tmp/vllm && \
    python3 /tmp/patch_qwen3_dflash_dtype.py

