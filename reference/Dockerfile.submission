ARG BASE_IMAGE=adaptfm-vllm:dflash-v0201
FROM ${BASE_IMAGE}

COPY submission_context/qwen-weights/ /opt/ml/model/
COPY submission_context/dflash-draft/ /opt/ml/dflash-draft/

# Noel: replace these with the exact submitted files.
COPY serve_vllm_contest.py /opt/program/serve_vllm_contest.py
COPY entrypoint.sh /opt/program/entrypoint.sh

ENV MODEL_ID=/opt/ml/model
ENV TOKENIZER_ID=/opt/ml/model
ENV SERVED_MODEL_NAME=Qwen/Qwen3.5-4B
ENV QUANTIZATION=awq_marlin
ENV SPECULATIVE_CONFIG={"method":"dflash","model":"/opt/ml/dflash-draft","num_speculative_tokens":15}
ENV ENABLE_PREFIX_CACHING=1
ENV LANGUAGE_MODEL_ONLY=1
ENV VLLM_EXTRA_ARGS=--skip-mm-profiling
ENV MAX_MODEL_LEN=8448
ENV GPU_MEMORY_UTILIZATION=0.90
ENV MAX_NUM_SEQS=1
ENV DTYPE=half
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1
ENV HF_HUB_OFFLINE=1

ENTRYPOINT ["bash", "/opt/program/entrypoint.sh"]

